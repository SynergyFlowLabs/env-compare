{
  "name": "EnvCompare — see what your .env is missing",
  "short_name": "EnvCompare",
  "description": "Compare two to eight .env files in the browser. Nothing is uploaded or stored.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#101215",
  "theme_color": "#101215",
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ]
}
